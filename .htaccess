# The app is deployed with its repository root as the document root
# (Hostinger's public_html), so requests have to be routed into Laravel's
# public/ folder and everything else kept out of reach. Apache/LiteSpeed only
# reads this file when the repository root is the document root - if the
# document root is ever pointed at public_html/public instead, this file is
# ignored and can be deleted.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Application internals are never web-reachable, whatever the rewrites below do.
    RewriteRule ^(\.env|\.git|\.editorconfig|\.gitattributes|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|postcss\.config\.js|tailwind\.config\.js|vite\.config\.js|setup-lan-access\.ps1) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|docs|node_modules|resources|routes|scripts|storage|tests|vendor)/ - [F,L]

    # Everything else goes through Laravel's front controller in public/, which
    # has its own .htaccess. The condition stops the rewrite looping.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Belt and braces, in case mod_rewrite is ever unavailable.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
